# AskCharts on a server: copy this file to .env and fill it in.

# The address you'll open AskCharts at, with https (your domain or a subdomain of it)
ASKCHARTS_ORIGIN=https://charts.example.com

# The one account that can sign in (passkeys are added with a one-time link for it)
ASKCHARTS_EMAIL=you@example.com

# Sign-in links: log writes them to the log (read with: docker compose logs askcharts),
# resend emails them (a sending-only key from resend.com, and who the mail is from)
MAIL_MODE=log
RESEND_API_KEY=
MAIL_FROM=

# Optional: the Cloudflare tunnel's token (docker compose --profile tunnel up -d)
TUNNEL_TOKEN=

# What's in front of AskCharts, so the sign-in limits count each visitor:
#   cloudflare  a Cloudflare tunnel (the server guide's step 3A)
#   forwarded   Caddy, nginx or another web server of your own (step 3B)
#   empty       nothing in front
# Set it only to what you really use: anyone can send the headers it trusts.
ASKCHARTS_TRUST_PROXY=

# Optional: the port on this server (only this server can reach it)
ASKCHARTS_PORT=3778
